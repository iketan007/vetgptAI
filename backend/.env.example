# Copy this file to .env and fill in as needed

# --- LLM provider: openai_compatible | llama_cpp | hf_endpoint ---
# Default: openai_compatible pointed at Groq (free tier, hosts Llama models,
# no GPU/RAM needed on your server) -- easiest path to a public deployment.
LLM_PROVIDER=openai_compatible

# openai_compatible settings -- get a free key at https://console.groq.com
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_API_KEY=your_groq_api_key_here
OPENAI_COMPATIBLE_MODEL=llama-3.1-8b-instant
# (check console.groq.com/docs/models for current available model names)

# --- OR: local GGUF model instead (needs 6-8GB+ RAM on the host) ---
# LLM_PROVIDER=llama_cpp
# LLAMA_MODEL_PATH=./models/llama-2-7b-chat.Q4_K_M.gguf
# LLAMA_N_CTX=4096
# LLAMA_N_GPU_LAYERS=0

# --- OR: a Hugging Face Inference Endpoint ---
# LLM_PROVIDER=hf_endpoint
# HF_ENDPOINT_URL=
# HF_API_TOKEN=

# Embeddings
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large

# Retrieval / generation tuning
RETRIEVER_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MAX_NEW_TOKENS=512
TEMPERATURE=0.3

# CORS - comma separated origins, or * for all
ALLOWED_ORIGINS=*
